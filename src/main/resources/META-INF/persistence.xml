<!--        <class>my.example.awards.pktest.sourceentities.TableIdEntity</class>-->
<!--        <class>my.example.awards.pktest.sourceentities.UuidEntity</class>-->

<!--        <class>my.example.awards.pktest.reversegen.AutoIdEntity</class>-->
<!--        <class>my.example.awards.pktest.reversegen.AutoUuidEntity</class>-->
<!--        <class>my.example.awards.pktest.reversegen.IdentityIdEntity</class>-->
<!--        <class>my.example.awards.pktest.reversegen.PlainIdEntity</class>-->
<!--        <class>my.example.awards.pktest.reversegen.SeqByOrmIdEntity</class>-->
